[Unit]
Description=Pocket CRM — deals from the first talk to signed
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-crm
Group=pocket-crm
ExecStart=/usr/local/bin/pocket-crm
Environment=DATA_DIR=/var/lib/pocket-crm
Environment=PORT=8080
Environment=BASE_URL=https://crm.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-crm
PrivateTmp=true

[Install]
WantedBy=multi-user.target
